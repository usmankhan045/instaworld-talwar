// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model OrderBooking {
  id             String    @id @default(cuid())
  shop           String
  orderId        String
  orderNumber    String
  trackingNumber String?
  status         String    @default("pending")
  declaredWeight Float?
  paymentType    String?
  amountDue      Float?
  bookedAt       DateTime?
  apiError       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, orderId], name: "orderBooking_unique")
  @@index([shop, orderNumber])
}

model Shipment {
  id                    String                 @id @default(cuid())
  shop                  String
  refNo                 String
  trackingNumber        String?
  status                String                 @default("pending")
  declaredWeight        Float?
  paymentType           String?
  amountDue             Float?
  currencyCode          String?
  bookedAt              DateTime?
  instaworldStatus      String? // Last known InstaWorld PublicStatusCode
  shopifyFulfillmentId  String? // Shopify fulfillment GID
  lastSyncedAt          DateTime? // When this shipment was last synced
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  instaworldAccountId   String?
  orders                ShipmentOrder[]
  attempts              BookingAttempt[]
  whatsappNotifications WhatsAppNotification[]

  @@unique([shop, refNo], name: "shipment_shop_refNo_key")
  @@index([shop, trackingNumber])
}

model WhatsAppAccount {
  id                String                 @id @default(cuid())
  shop              String
  accountKey        String
  phoneNumberId     String
  businessAccountId String?
  enabled           Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  notifications     WhatsAppNotification[]

  @@unique([shop, accountKey], name: "whatsappAccount_shop_accountKey_key")
  @@unique([shop, phoneNumberId], name: "whatsappAccount_shop_phoneNumberId_key")
  @@index([shop, enabled])
}

model WhatsAppTemplate {
  id           String   @id @default(cuid())
  shop         String
  accountKey   String
  eventType    String
  templateName String
  languageCode String   @default("en_US")
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, accountKey, eventType], name: "whatsappTemplate_shop_account_event_key")
  @@index([shop, enabled])
}

model WhatsAppNotification {
  id                String          @id @default(cuid())
  shop              String
  accountKey        String
  eventType         String
  idempotencyKey    String
  shipmentId        String?
  shopifyOrderId    String?
  recipientPhone    String
  templateName      String
  languageCode      String          @default("en_US")
  parametersJson    String
  documentUrl       String?
  status            String          @default("pending")
  attempts          Int             @default(0)
  nextAttemptAt     DateTime?
  leaseUntil        DateTime?
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  account           WhatsAppAccount @relation(fields: [shop, accountKey], references: [shop, accountKey], onDelete: Restrict)
  shipment          Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@unique([shop, idempotencyKey], name: "whatsappNotification_shop_idempotencyKey_key")
  @@index([shop, status, nextAttemptAt, leaseUntil])
  @@index([shop, shipmentId])
  @@index([shop, providerMessageId])
}

model WhatsAppWebhookEvent {
  id                String    @id @default(cuid())
  providerMessageId String?
  eventType         String
  payloadJson       String
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@unique([providerMessageId, eventType], name: "whatsappWebhook_providerMessage_event_key")
  @@index([receivedAt])
}

model SyncState {
  id           String   @id @default(cuid())
  shop         String   @unique
  lastSyncedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShipmentOrder {
  id                 String   @id @default(cuid())
  shop               String
  shipmentId         String
  shopifyOrderId     String
  shopifyOrderNumber String
  createdAt          DateTime @default(now())
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shop, shopifyOrderId], name: "shipmentOrder_shop_shopifyOrderId_key")
  @@unique([shipmentId, shopifyOrderId], name: "shipmentOrder_shipment_order_key")
  @@index([shop, shipmentId])
}

model BookingAttempt {
  id                 String    @id @default(cuid())
  shop               String
  shipmentId         String
  idempotencyKey     String
  status             String    @default("created")
  requestFingerprint String
  requestPayload     String?
  lastErrorCode      String?
  lastErrorMessage   String?
  lastHttpStatus     Int?
  startedAt          DateTime?
  completedAt        DateTime?
  leaseExpiresAt     DateTime?
  leaseToken         String?
  recoveryCount      Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shipment           Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shop, idempotencyKey], name: "bookingAttempt_shop_idempotencyKey_key")
  @@unique([shop, shipmentId], name: "bookingAttempt_shop_shipmentId_key")
}

model OrderReservation {
  id             String    @id @default(cuid())
  shop           String
  shopifyOrderId String
  attemptId      String
  state          String    @default("active")
  leaseExpiresAt DateTime
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, shopifyOrderId], name: "orderReservation_shop_shopifyOrderId_key")
  @@unique([attemptId, shopifyOrderId], name: "orderReservation_attempt_order_key")
  @@index([shop, attemptId])
}

model CallJob {
  id                 String        @id @default(cuid())
  shop               String
  shopifyOrderId     String
  shopifyOrderNumber String
  customerName       String
  phone              String
  productSummary     String
  normalizedAddress  String
  orderStatus        String        @default("pending")
  addressStatus      String        @default("pending")
  callStatus         String        @default("queued")
  attemptCount       Int           @default(0)
  nextAttemptAt      DateTime?
  activeLeaseToken   String?
  leaseExpiresAt     DateTime?
  lastCallAttemptId  String?
  bookingAttemptId   String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  attempts           CallAttempt[]

  @@unique([shop, shopifyOrderId], name: "callJob_shop_shopifyOrderId_key")
  @@index([shop, callStatus, nextAttemptAt])
  @@index([shop, phone])
}

model InstaWorldAccount {
  id         String   @id @default(cuid())
  shop       String
  name       String
  apiKeyEncrypted String
  baseUrl    String   @default("https://api.instaworld.pk/v2")
  locationId Int
  externalAccountId String?
  accountDetailsJson String @default("{}")
  locationsJson String @default("[]")
  couriersJson String @default("[]")
  lastSyncedAt DateTime @default(now())
  cityCatalogJson String @default("[]")
  cityCatalogSyncedAt DateTime?
  mode       String   @default("live")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, name], name: "instaworldAccount_shop_name_key")
  @@index([shop, isDefault])
  @@index([shop, externalAccountId])
}

model CallAttempt {
  id                String    @id @default(cuid())
  callJobId         String
  attemptNumber     Int
  asteriskCallId    String?
  sipProviderCallId String?
  status            String    @default("created")
  orderChoice       String?
  addressChoice     String?
  callResult        String?
  spokenNameText    String?
  spokenProductText String?
  spokenAddressText String?
  audioFileKeys     String?
  failureCode       String?
  failureMessage    String?
  startedAt         DateTime?
  answeredAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  callJob           CallJob   @relation(fields: [callJobId], references: [id], onDelete: Restrict)

  @@unique([callJobId, attemptNumber], name: "callAttempt_callJobId_attemptNumber_key")
  @@unique([asteriskCallId], name: "callAttempt_asteriskCallId_key")
  @@index([callJobId, status])
  @@index([sipProviderCallId])
}
